<Window x:Class="Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Habit Tracker"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="520"
        Background="#F3F6FB"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65728A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#5265E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="Transparent"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#26334A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#26334A"/>
            <Setter Property="CaretBrush" Value="#26334A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderBrush" Value="#CBD4E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#26334A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="#CBD4E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,18">
            <WrapPanel DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Content="Statistics"
                        Click="Stats_Click"
                        Margin="0,0,8,0"/>
                <Button Content="Export CSV"
                        Click="ExportCsv_Click"
                        Margin="0,0,8,0"/>
                <Button Content="Backup JSON"
                        Click="BackupJson_Click"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Click="Save_Click"/>
            </WrapPanel>

            <StackPanel>
                <TextBlock Text="My Tracker"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#202B40"/>
                <TextBlock Text="Track your habits one day at a time."
                           FontSize="13"
                           Foreground="#68758A"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,14">

            <WrapPanel VerticalAlignment="Center">

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="MONTH"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="MonthSelector"
                              Width="155"
                              Height="38"
                              MaxDropDownHeight="450"/>
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="CATEGORY NAME"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="CategoryInput"
                             Width="155"
                             Height="38"
                             ToolTip="Enter a category name"/>
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="CATEGORY ACTIONS"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ Add"
                                Height="38"
                                Click="AddCategory_Click"
                                Margin="0,0,6,0"/>
                        <ComboBox x:Name="CategoryToManage"
                                  Width="125"
                                  Height="38"
                                  ToolTip="Choose a category to edit or delete"
                                  Margin="0,0,6,0"/>
                        <Button Content="Rename"
                                Height="38"
                                Click="RenameCategory_Click"
                                Margin="0,0,6,0"/>
                        <Button Content="Delete"
                                Height="38"
                                Background="#C94B55"
                                Click="DeleteCategory_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="PERSON 1 COLOR"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="LeftColorInput"
                                 Width="100"
                                 Height="38"
                                 Text="#90EE90"
                                 TextChanged="ColorInput_TextChanged"/>
                        <Border x:Name="LeftColorPreview"
                                Width="28"
                                Height="28"
                                Margin="7,5,0,5"
                                Background="#90EE90"
                                BorderBrush="#CBD4E2"
                                BorderThickness="1"
                                CornerRadius="4"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="PERSON 2 COLOR"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="RightColorInput"
                                 Width="100"
                                 Height="38"
                                 Text="#ADD8E6"
                                 TextChanged="ColorInput_TextChanged"/>
                        <Border x:Name="RightColorPreview"
                                Width="28"
                                Height="28"
                                Margin="7,5,0,5"
                                Background="#ADD8E6"
                                BorderBrush="#CBD4E2"
                                BorderThickness="1"
                                CornerRadius="4"/>
                    </StackPanel>
                </StackPanel>

            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Monthly overview"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#26334A"/>
                    <TextBlock Text="Left-click: Person 1 · Right-click: Person 2 · Opposite person creates a split · Middle-click toggles split · Click a marked color again to clear"
                               FontSize="12"
                               Foreground="#68758A"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="TrackerGrid"/>
                </ScrollViewer>

                <TextBlock x:Name="SaveStatus"
                           Grid.Row="2"
                           Text="Changes save automatically."
                           FontSize="11"
                           Foreground="#68758A"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>